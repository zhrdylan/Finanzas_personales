# ============================================================ #
# Flux — Finanzas Personales · plantilla de configuración
# Copia este archivo a .env y ajusta los valores:
#   copy .env.example .env
# El .env NUNCA se sube al repositorio (está en .gitignore).
# ============================================================ #

# --- Seguridad (OBLIGATORIA) ---
# Genera una propia con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-generada-de-64-caracteres-hex
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Base de datos (MySQL únicamente, driver aiomysql) ---
# Laragon por defecto (root sin contraseña):
DATABASE_URL=mysql+aiomysql://root:@127.0.0.1:3306/finanzas_personales
# Si root tiene contraseña (codifica @ → %40, : → %3A, / → %2F):
# DATABASE_URL=mysql+aiomysql://root:TuContraseña@127.0.0.1:3306/finanzas_personales

# --- Inicio de sesión con Google (opcional) ---
# Client ID de Google Cloud (Authorized JavaScript origins: tu dominio local
# y el de producción). Vacío = botón de Google apagado.
GOOGLE_CLIENT_ID=

# --- CORS (orígenes separados por coma) ---
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Rate limiting del login ---
LOGIN_RATE_LIMIT=5/minute

# --- Tasas de cambio (Frankfurter v2, sin API key) ---
EXCHANGE_BASE_URL=https://api.frankfurter.dev/v2
EXCHANGE_TIMEOUT_S=8.0

# --- Depuración (false en producción) ---
DEBUG=false
